---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ari Cartagena</title>
    <meta name="description" content="CE student at FAU. Mods Silksong. Fixes hardware." />
    <meta name="author" content="Ari Cartagena" />
    <meta property="og:title" content="Ari Cartagena" />
    <meta property="og:description" content="CE student at FAU. Mods Silksong. Fixes hardware." />
    <meta property="og:url" content="https://datuub.github.io" />
    <link rel="canonical" href="https://datuub.github.io" />
  </head>
  <body>
    <div class="container">
      <header>
        <h1 class="name">Ari Cartagena</h1>
        <p class="handle">@datuub</p>
        <p class="tagline">CE @ FAU <span class="sep">/</span> mods <span class="sep">/</span> hardware</p>
        <nav class="links">
          <a href="https://github.com/datuub" target="_blank" rel="noopener">GitHub</a>
          <a href="https://discord.com/users/Uub__" target="_blank" rel="noopener">Discord</a>
          <a href="mailto:personal@arisafari.me">Email</a>
        </nav>
      </header>

      <hr />

      <section>
        <h2 class="section-label">Projects</h2>

        <div class="project">
          <div class="project-title">
            <a href="https://thunderstore.io/c/hollow-knight-silksong/p/DatUub/QuestMod/" target="_blank" rel="noopener">QuestMod</a>
            <span class="project-meta">quest editor and manager</span>
          </div>
          <p class="project-desc">
            Edit quest targets, manage chains, customize with a debug GUI.
            Accept, complete, track. Reworks how Silksong quests work.
            <a href="https://github.com/DatUub/Silksong.QuestMod" target="_blank" rel="noopener">Source</a>
          </p>
        </div>

        <div class="project">
          <div class="project-title">
            Hardware
            <span class="project-meta">repair, build, tinker</span>
          </div>
          <p class="project-desc">
            Board-level repair, soldering, console mods.
            Framework laptops, Nintendo Switch hardware mods, iPhone screens.
            Built my own PC. If it has a board I'll probably take it apart.
          </p>
        </div>

        <p class="more-link">
          <a href="https://github.com/datuub" target="_blank" rel="noopener">github.com/datuub</a>
          for everything else
        </p>
      </section>

      <hr />

      <footer class="footer">
        <p class="footer-text">
          <a href="https://github.com/DatUub/DatUub.github.io" target="_blank" rel="noopener">Source</a>
          <span class="sep">/</span>
          Astro
          <span class="sep">/</span>
          Catppuccin Mocha
        </p>
      </footer>
    </div>

    <script>
      const konamiCode = [
        "ArrowUp", "ArrowUp", "ArrowDown", "ArrowDown",
        "ArrowLeft", "ArrowRight", "ArrowLeft", "ArrowRight",
        "b", "a", "Enter",
      ];
      let cursor = 0;

      document.addEventListener("keydown", (e) => {
        const key = e.key.toLowerCase();
        const target = konamiCode[cursor].toLowerCase();
        const code = e.code;
        if (key === target || code === konamiCode[cursor]) {
          cursor++;
          if (cursor === konamiCode.length) {
            activateGodMode();
            cursor = 0;
          }
        } else {
          cursor = 0;
        }
      });

      let tapTimes = [];

      document.addEventListener("click", (e) => {
        const now = Date.now();
        if (tapTimes.length > 0 && now - tapTimes[tapTimes.length - 1] > 2000) {
          tapTimes = [];
        }
        tapTimes.push(now);
        if (tapTimes.length === 7) {
          const intervals = [];
          for (let i = 1; i < tapTimes.length; i++) {
            intervals.push(tapTimes[i] - tapTimes[i - 1]);
          }
          const fastPart = intervals.slice(0, 5);
          const avgFast = fastPart.reduce((a, b) => a + b, 0) / fastPart.length;
          const bigGap = intervals[5];
          const isCluster = fastPart.every((i) => i < 600);
          const isGap = bigGap > avgFast * 1.5;
          if (isCluster && isGap) {
            activateGodMode();
          }
          tapTimes = [];
        }
      });

      function activateGodMode() {
        document.body.contentEditable = "true";
        document.designMode = "on";
        const style = document.createElement("style");
        style.innerHTML = `
          * { transition: all 0.3s ease; }
          .project, hr, .links a, footer {
            animation: rainbow-border 2s linear infinite !important;
            border: 2px solid transparent !important;
          }
          @keyframes rainbow-border {
            0%  { border-color: #ff0000; box-shadow: 0 0 15px #ff0000; }
            20% { border-color: #ffff00; box-shadow: 0 0 15px #ffff00; }
            40% { border-color: #00ff00; box-shadow: 0 0 15px #00ff00; }
            60% { border-color: #00ffff; box-shadow: 0 0 15px #00ffff; }
            80% { border-color: #0000ff; box-shadow: 0 0 15px #0000ff; }
            100%{ border-color: #ff00ff; box-shadow: 0 0 15px #ff00ff; }
          }
        `;
        document.head.appendChild(style);
        if (navigator.vibrate)
          navigator.vibrate([50, 30, 50, 30, 50, 30, 50, 200, 100, 100, 100]);
        alert("God mode activated. Edit anything.");
      }
    </script>
  </body>
</html>

<style>
  .container {
    max-width: 680px;
    margin: 0 auto;
    padding: 100px 32px;
  }

  hr {
    border: none;
    border-top: 1px solid var(--ctp-surface0);
    margin: 56px 0;
  }

  .name {
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    font-weight: 700;
    color: var(--ctp-text);
    margin: 0;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .handle {
    font-family: 'JetBrains Mono', monospace;
    font-size: 1.1rem;
    color: var(--ctp-overlay0);
    margin: 8px 0 0;
  }

  .tagline {
    color: var(--ctp-lavender);
    font-size: 1.15rem;
    margin: 16px 0 0;
    font-weight: 500;
  }

  .sep {
    color: var(--ctp-surface1);
    margin: 0 10px;
  }

  .links {
    display: flex;
    gap: 28px;
    margin-top: 24px;
  }

  .links a {
    color: var(--ctp-subtext0);
    font-size: 1rem;
    font-weight: 500;
  }

  .links a:hover {
    color: var(--ctp-lavender);
  }

  .section-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--ctp-overlay0);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 32px;
  }

  .project {
    margin-bottom: 36px;
  }

  .project:last-of-type {
    margin-bottom: 0;
  }

  .project-title {
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--ctp-text);
    margin-bottom: 6px;
    line-height: 1.3;
  }

  .project-title a {
    color: var(--ctp-text);
  }

  .project-title a:hover {
    color: var(--ctp-lavender);
  }

  .project-meta {
    color: var(--ctp-subtext0);
    font-weight: 400;
    font-size: 1rem;
  }

  .project-desc {
    color: var(--ctp-subtext0);
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0;
  }

  .project-desc a {
    color: var(--ctp-lavender);
  }

  .project-desc a:hover {
    text-decoration: underline;
  }

  .more-link {
    margin-top: 28px;
    font-size: 0.9rem;
    color: var(--ctp-subtext0);
  }

  .more-link a {
    color: var(--ctp-lavender);
  }

  .more-link a:hover {
    text-decoration: underline;
  }

  .footer-text {
    color: var(--ctp-overlay0);
    font-size: 0.85rem;
    margin: 0;
  }

  .footer-text a {
    color: var(--ctp-overlay0);
  }

  .footer-text a:hover {
    color: var(--ctp-lavender);
  }

  @media (max-width: 600px) {
    .container {
      padding: 60px 20px;
    }
    hr {
      margin: 40px 0;
    }
    .links {
      flex-wrap: wrap;
      gap: 20px;
    }
    .project-title {
      font-size: 1.1rem;
    }
  }
</style>
